# OpenAI / Vercel Gateway configuration
# These are reference values — the extension actually reads credentials from chrome.storage.local
# (configured via the extension popup). This file is for local scripts / dev tooling only.

OPENAI_API_KEY=sk-replace-me
VERCEL_GATEWAY_URL=https://ai-gateway.vercel.sh/v1/chat/completions
AI_MODEL=poolside/laguna-s-2.1-free
AI_TIMEOUT_MS=10000
