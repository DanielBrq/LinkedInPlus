{
  "manifest_version": 3,
  "name": "LinkedIn Job Description Collector",
  "version": "2.2.0",
  "description": "AI-powered LinkedIn job description collector. Extracts, classifies, and saves structured job data matching your profile.",
  "author": { "name": "Daniel Barquero", "url": "https://www.linkedin.com/in/danielbrq/" },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://ai-gateway.vercel.sh/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://api.groq.com/*",
    "https://api.together.xyz/*",
    "https://api.perplexity.ai/*",
    "https://api.mistral.ai/*",
    "https://openrouter.ai/*",
    "https://integrate.api.nvidia.com/*",
    "https://api-inference.huggingface.co/*",
    "https://api.fireworks.ai/*",
    "https://api.cohere.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://*.openai.azure.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://192.168.0.5/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Job Collector"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/constants.js",
        "lib/parser.js",
        "lib/storage.js",
        "lib/settings.js",
        "lib/utils.js",
        "lib/observer.js",
        "lib/aiFilter.js",
        "lib/pipeline.js",
        "lib/mediaBlocker.js",
        "viewer/index.html",
        "presets/index.html",
        "presets/presets.js"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ]
    }
  ]
}
