{
  "manifest_version": 3,
  "name": "LinkedIn Post Classifier",
  "version": "2.2.1",
  "description": "Classifies LinkedIn posts against configurable job-search preferences.",
  "author": { "name": "Daniel Barquero", "url": "https://www.linkedin.com/in/danielbrq/" },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://ai-gateway.vercel.sh/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "LinkedIn Post Classifier"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/constants.js",
        "lib/parser.js",
        "lib/settings.js",
        "lib/utils.js",
        "lib/observer.js",
        "lib/aiFilter.js",
        "lib/pipeline.js"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ]
    }
  ]
}
